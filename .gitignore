# Track only reviewed source, shared assets and public documentation.
# Local traces, binaries, compiler, PSDs and backups stay untracked.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/LICENSE
!/build.ps1
!/test.ps1
!/assets/
/assets/*
!/assets/tutorial-hand.svg
!/assets/Gesture.ico
!/src/
/src/*
!/src/gesture_host.c
!/src/settings_ui.c
!/src/user32-extra.def
!/src/app_shared.h
!/src/app_language.h
!/src/compositor_api.h
!/src/main_caption.h
!/src/main_compositor.h
!/src/main_feedback.h
!/src/main_psd_layout.h
!/src/main_surface.h
!/src/main_window.h
!/src/tray_icon.h
!/src/tray_panel.h
!/src/touchpad_prepare.h
!/src/ui_graphics.h
!/src/generated/
/src/generated/*
!/src/generated/tutorial_hand.h
!/src/generated/app_strings.h
!/tests/
/tests/*
!/tests/gesture_release_probe.c
!/tests/normal_lift_probe.c
!/tests/ai_prompt_probe.c
!/tests/window_geometry_probe.c
!/tests/language_probe.c
!/scripts/
/scripts/*
!/scripts/generate-hand.ps1
!/scripts/generate-language.ps1
!/scripts/Set-SettingsBranding.ps1
!/scripts/Install.ps1
!/docs/
/docs/*
!/docs/LICENSE.upstream.txt
!/docs/release-manifest.json
!/locales/
/locales/*
!/locales/zh-CN.json
!/locales/zh-TW.json
!/locales/en.json
!/locales/ja.json
!/locales/ko.json
!/locales/de.json
!/locales/fr.json
!/locales/es.json
!/locales/pt.json
